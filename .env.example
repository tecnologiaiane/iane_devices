# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: String de conexão PostgreSQL para servidores on-premise ou cloud.
# Exemplo: postgres://usuario:senha@localhost:5432/telecom_assets
DATABASE_URL="postgres://iane_admin:SuaSenhaForteAqui123!@localhost:5432/telecom_assets"

# PORT: Porta HTTP de execução (padrão: 3000)
PORT=3000

# JWT_SECRET: segredo usado para assinar os tokens de login.
# Gere um valor forte e fixo, por exemplo com: openssl rand -hex 48
# OBRIGATÓRIA no docker-compose e recomendada em produção (as sessões sobrevivem a reinícios).
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# JWT_EXPIRES_IN: validade do token de sessão (padrão: 12h). Ex.: 8h, 12h, 1d.
JWT_EXPIRES_IN="12h"

# TZ: fuso horário usado pelo servidor e pelo PostgreSQL (padrão: America/Sao_Paulo).
TZ="America/Sao_Paulo"

# ALLOW_MEMORY_FALLBACK: NUNCA use true em produção. Apenas para desenvolvimento sem PostgreSQL.
ALLOW_MEMORY_FALLBACK="false"

# POSTGRES_BIND_IP: interface onde a porta 5432 é publicada.
# 127.0.0.1 = somente pela própria máquina. Use 0.0.0.0 para DBeaver externo,
# restringindo a porta 5432 ao firewall da rede interna.
POSTGRES_BIND_IP="127.0.0.1"

# POSTGRES_PASSWORD / DATABASE_URL (docker-compose) — OBRIGATÓRIAS no compose:
# Use uma senha forte e a MESMA senha codificada na URL de conexão.
# Caracteres especiais precisam ser percent-encoded (@ -> %40, ! -> %21, # -> %23).
# POSTGRES_PASSWORD="SuaSenhaForteAqui123!"
# DATABASE_URL="postgres://iane_admin:SuaSenhaForteAqui123%21@postgres:5432/telecom_assets"

# BACKUP: rotina automática das tabelas do PostgreSQL em arquivos JSON no servidor.
# BACKUP_INTERVAL_HOURS: intervalo entre cópias automáticas (padrão: 24).
# BACKUP_RETENTION: quantas cópias manter; as mais antigas são removidas (padrão: 14).
# BACKUP_DIR: pasta onde os arquivos são gravados (no Docker, use /app/backups).
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
# BACKUP_DIR="./backups"

