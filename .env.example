# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: String de conexão PostgreSQL para servidores on-premise ou cloud.
# Exemplo: postgres://usuario:senha@localhost:5432/telecom_assets
DATABASE_URL="postgres://iane_admin:SuaSenhaForteAqui123!@localhost:5432/telecom_assets"

# PORT: Porta HTTP de execução (padrão: 3000)
PORT=3000

# JWT_SECRET: segredo usado para assinar os tokens de login.
# Gere um valor forte e fixo, por exemplo com: openssl rand -hex 48
# Em produção, configure esta variável para que as sessões sobrevivam a reinícios.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# POSTGRES_PASSWORD / DATABASE_URL (docker-compose):
# Use uma senha forte e a mesma senha codificada na URL de conexão.
# POSTGRES_PASSWORD="SuaSenhaForteAqui123!"
# DATABASE_URL="postgres://iane_admin:SuaSenhaForteAqui123%21@postgres:5432/telecom_assets"

